# --- Core ---
# SQLAlchemy dialect: psycopg v3. postgres:// and postgresql:// are rewritten
# to postgresql+psycopg:// (Railway/Heroku would otherwise load psycopg2).
DATABASE_URL=postgresql+psycopg://sin_linea:sin_linea@localhost:5432/sin_linea
# Solo pytest. Nombre *_test y distinta de DATABASE_URL. Si falta, pytest aborta.
TEST_DATABASE_URL=postgresql+psycopg://sin_linea:sin_linea@localhost:5432/sin_linea_test
REDIS_URL=redis://localhost:6379/0

ADMIN_PASSWORD=dev-admin
APP_SECRET=dev-secret-change-me

CORS_ORIGINS=http://localhost:3000
API_URL=http://localhost:8000
# Origen público del frontend (canonical, Open Graph, sitemap, robots).
# En producción usá https://dominio-real sin slash final.
# No uses API_URL: en Compose es interno (http://api:8000).
# En Vercel, definila en Production. Preview no se indexa (VERCEL_ENV).
SITE_URL=http://localhost:3000
# IPs/CIDR that may set X-Forwarded-For. Vacío = no confiar en ese encabezado.
TRUSTED_PROXIES=

# Poll periódico de fuentes vigiladas (Celery Beat).
# Cuántos ítems recientes inspecciona cada poll por fuente (antes de descargar HTML).
MONITORED_SOURCE_POLL_LIMIT=5
# Cada cuántos segundos Beat dispara poll_monitored_sources. Default 300s (5 min).
MONITORED_SOURCE_POLL_INTERVAL_SECONDS=300
# Tope de sucesos nuevos por Poll. El poll automático encola como máximo
# esas notas a detección. El botón admin "Procesar N más" sigue con otras
# PENDING si las primeras son duplicado o SKIPPED, hasta el tope de sucesos.
# 0 = sin tope. Para testeo local acotado usá 3.
MAX_NEW_EVENTS_PER_POLL=3

# --- AI providers (keys only; never commit real values) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
VOYAGE_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=

# Role → provider/model.
# Usá IDs reales de la API del vendor (p. ej. gpt-5.6-luna, no aliases conceptuales).
# Ultra-light (extracción inicial / queries y relevancia de research)
ULTRA_LIGHT_PROCESSING_PROVIDER=openai
ULTRA_LIGHT_PROCESSING_MODEL=gpt-5-nano

# Luna (fallback de extracción, claim extraction)
LIGHT_PROCESSING_PROVIDER=openai
LIGHT_PROCESSING_MODEL=gpt-4o-mini

# Dedup ambigua (DeepSeek; mismo adapter que claims). Si faltan, el código usa CLAIM_RESOLUTION.
AMBIGUOUS_DEDUP_PROVIDER=deepseek
AMBIGUOUS_DEDUP_MODEL=deepseek-chat

# Resolución económica de claims (flash) + escalado selectivo
CLAIM_RESOLUTION_PROVIDER=deepseek
CLAIM_RESOLUTION_MODEL=deepseek-v4-flash
# Si faltan, el código usa CLAIM_RESOLUTION (no tumba el pipeline).
CLAIM_RESOLUTION_ESCALATED_PROVIDER=deepseek
CLAIM_RESOLUTION_ESCALATED_MODEL=deepseek-chat
CLAIM_RESOLUTION_ESCALATE_CONFIDENCE=0.55

# Prompt visual de la portada (DeepSeek; misma API key). No envía cuerpo ni claims.
IMAGE_PROMPT_PROVIDER=deepseek
IMAGE_PROMPT_MODEL=deepseek-chat

# Portada FLUX Schnell. Una imagen por artículo; el fallo no bloquea la publicación.
REPLICATE_API_TOKEN=
ARTICLE_IMAGE_ENABLED=true
ARTICLE_IMAGE_MODEL=black-forest-labs/flux-schnell
ARTICLE_IMAGE_ASPECT_RATIO=16:9
ARTICLE_IMAGE_OUTPUT_FORMAT=webp
ARTICLE_IMAGE_OUTPUT_QUALITY=80
ARTICLE_IMAGE_NUM_INFERENCE_STEPS=4
ARTICLE_IMAGE_MEGAPIXELS=1
ARTICLE_IMAGE_GO_FAST=true

# Sol (verificación)
VERIFICATION_PROVIDER=openai
VERIFICATION_MODEL=gpt-4o

# GPT-5.6 Luna (redacción)
WRITING_PROVIDER=openai
WRITING_MODEL=gpt-5.6-luna
WRITING_REASONING_EFFORT=none

# Sol (auditoría) — no usar anthropic acá
AUDITING_PROVIDER=openai
AUDITING_MODEL=gpt-4o

# Embeddings
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3

# Search: brave | exa
SEARCH_PROVIDER=exa

# --- Product flags ---
# MVP: true = si Sol aprueba, el worker publica V1 y actualizaciones.
# false = Audit passed deja READY_FOR_REVIEW (publicación manual).
AUTO_PUBLISH=true

MAX_RESEARCH_QUERIES_PER_EVENT=4
INITIAL_RESEARCH_QUERIES=2
MAX_STANDARD_EVENT_SOURCES=4
MAX_ESCALATED_EVENT_SOURCES=8
MAX_RESEARCH_RESULTS_PER_QUERY=5
MAX_RESEARCH_RESULTS_PER_DOMAIN=3
MAX_VERIFICATION_CLAIMS_PER_EVENT=5
MAX_VERIFICATION_QUERIES_PER_CLAIM=3
MAX_VERIFICATION_RESULTS_PER_QUERY=3
MAX_WRITING_CLAIMS_PER_EVENT=40
MAX_WRITING_SOURCES_PER_EVENT=20
MAX_WRITING_SOURCE_CONTEXTS=6
WRITING_SOURCE_CONTEXT_CHARS=5000
WRITING_EXCERPT_CHARS=400
WRITING_MAX_OUTPUT_TOKENS=4096
CLAIM_EXTRACTION_SOURCE_CHARS=5000
EDITORIAL_COUNTRY_CODE=AR
MAX_AUDIT_REWRITE_CYCLES=2

JOB_MAX_RETRIES=3

EVENT_MATCH_HIGH_THRESHOLD=0.88
EVENT_MATCH_LOW_THRESHOLD=0.72

FEED_RELEVANCE_WEIGHT=1.0
FEED_FRESHNESS_WEIGHT=1.0
FEED_LOCALITY_WEIGHT=1.0

NEARBY_WINDOW_HOURS=12
