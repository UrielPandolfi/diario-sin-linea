# --- Core ---
DATABASE_URL=postgresql+psycopg://sin_linea:sin_linea@localhost:5432/sin_linea
REDIS_URL=redis://localhost:6379/0

ADMIN_PASSWORD=dev-admin
APP_SECRET=dev-secret-change-me

CORS_ORIGINS=http://localhost:3000
API_URL=http://localhost:8000

# Poll periódico de fuentes vigiladas (Celery Beat). Default 900s.
INGESTION_POLL_INTERVAL_SECONDS=900
# Tope de sucesos NUEVOS por Poll que encolan research→publish. 0 = sin tope.
# Para testeo local acotado usá 3.
MAX_NEW_EVENTS_PER_POLL=3

# --- AI providers (keys only; never commit real values) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
VOYAGE_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=

# Role → provider/model.
# Usá IDs reales de la API del vendor (no nombres conceptuales tipo "gpt-5.6-luna").
# Ultra-light (extracción inicial / queries y relevancia de research)
ULTRA_LIGHT_PROCESSING_PROVIDER=openai
ULTRA_LIGHT_PROCESSING_MODEL=gpt-5-nano

# Luna (fallback de extracción, claim extraction)
LIGHT_PROCESSING_PROVIDER=openai
LIGHT_PROCESSING_MODEL=gpt-4o-mini

# Terra (dedup ambigua)
AMBIGUOUS_DEDUP_PROVIDER=openai
AMBIGUOUS_DEDUP_MODEL=gpt-4o-mini

# Resolución económica de claims (flash) + escalado selectivo
CLAIM_RESOLUTION_PROVIDER=deepseek
CLAIM_RESOLUTION_MODEL=deepseek-v4-flash
# Si faltan, el código usa CLAIM_RESOLUTION (no tumba el pipeline).
CLAIM_RESOLUTION_ESCALATED_PROVIDER=deepseek
CLAIM_RESOLUTION_ESCALATED_MODEL=deepseek-chat
CLAIM_RESOLUTION_ESCALATE_CONFIDENCE=0.55

# Sol (verificación)
VERIFICATION_PROVIDER=openai
VERIFICATION_MODEL=gpt-4o

# Claude (redacción)
WRITING_PROVIDER=anthropic
WRITING_MODEL=claude-sonnet-4-5

# Sol (auditoría) — no usar anthropic acá
AUDITING_PROVIDER=openai
AUDITING_MODEL=gpt-4o

# Embeddings
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3

# Search: brave | exa
SEARCH_PROVIDER=exa

# --- Product flags ---
# Spec #85: presente en Settings. M9 no lo usa como gate; si Sol aprueba, se publica.
AUTO_PUBLISH=false

MAX_RESEARCH_QUERIES_PER_EVENT=4
INITIAL_RESEARCH_QUERIES=2
MAX_STANDARD_EVENT_SOURCES=4
MAX_ESCALATED_EVENT_SOURCES=8
MAX_RESEARCH_RESULTS_PER_QUERY=5
MAX_RESEARCH_RESULTS_PER_DOMAIN=3
MAX_VERIFICATION_CLAIMS_PER_EVENT=5
MAX_VERIFICATION_QUERIES_PER_CLAIM=2
MAX_VERIFICATION_RESULTS_PER_QUERY=3
MAX_WRITING_CLAIMS_PER_EVENT=40
MAX_WRITING_SOURCES_PER_EVENT=20
WRITING_EXCERPT_CHARS=400
WRITING_MAX_OUTPUT_TOKENS=4096
MAX_AUDIT_REWRITE_CYCLES=2

JOB_MAX_RETRIES=3

EVENT_MATCH_HIGH_THRESHOLD=0.88
EVENT_MATCH_LOW_THRESHOLD=0.72

FEED_RELEVANCE_WEIGHT=1.0
FEED_FRESHNESS_WEIGHT=1.0
FEED_LOCALITY_WEIGHT=1.0

NEARBY_WINDOW_HOURS=12
