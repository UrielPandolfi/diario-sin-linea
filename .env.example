# --- Core ---
DATABASE_URL=postgresql+psycopg://sin_linea:sin_linea@localhost:5432/sin_linea
REDIS_URL=redis://localhost:6379/0

ADMIN_PASSWORD=dev-admin
APP_SECRET=dev-secret-change-me

CORS_ORIGINS=http://localhost:3000
API_URL=http://localhost:8000

# Poll periódico de fuentes vigiladas (Celery Beat). Default 900s.
INGESTION_POLL_INTERVAL_SECONDS=900

# --- AI providers (keys only; never commit real values) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
VOYAGE_API_KEY=
BRAVE_API_KEY=

# Role → provider/model. Use real vendor model IDs, not conceptual names.
LIGHT_PROCESSING_PROVIDER=openai
LIGHT_PROCESSING_MODEL=

AMBIGUOUS_DEDUP_PROVIDER=openai
AMBIGUOUS_DEDUP_MODEL=

CLAIM_RESOLUTION_PROVIDER=deepseek
CLAIM_RESOLUTION_MODEL=

VERIFICATION_PROVIDER=openai
VERIFICATION_MODEL=

WRITING_PROVIDER=anthropic
WRITING_MODEL=

AUDITING_PROVIDER=openai
AUDITING_MODEL=

EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=

SEARCH_PROVIDER=brave

# --- Product flags ---
AUTO_PUBLISH=false

MAX_RESEARCH_QUERIES_PER_EVENT=4
MAX_RESEARCH_RESULTS_PER_QUERY=5
MAX_RESEARCH_RESULTS_PER_DOMAIN=3
MAX_AUDIT_REWRITE_CYCLES=2

JOB_MAX_RETRIES=3

EVENT_MATCH_HIGH_THRESHOLD=0.88
EVENT_MATCH_LOW_THRESHOLD=0.72

FEED_RELEVANCE_WEIGHT=1.0
FEED_FRESHNESS_WEIGHT=1.0
FEED_LOCALITY_WEIGHT=1.0

NEARBY_WINDOW_HOURS=12
