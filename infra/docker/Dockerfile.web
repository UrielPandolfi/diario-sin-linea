FROM node:22-alpine

WORKDIR /app

COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

COPY apps/web ./

ARG API_URL=http://api:8000
ARG SITE_URL=http://localhost:3000
ARG APP_SECRET=dev-secret-change-me
ENV API_URL=$API_URL \
    SITE_URL=$SITE_URL \
    APP_SECRET=$APP_SECRET \
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
